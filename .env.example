# Webshare proxy credentials
# Copy this to .env and fill in your real values
# .env is gitignored — won't be committed.

WEBSHARE_PROXY_USERNAME=your-username-here
WEBSHARE_PROXY_PASSWORD=your-password-here

# Optional: specific endpoint host:port (default Webshare rotating endpoint
# is p.webshare.io:80, change if you use a specific one)
WEBSHARE_PROXY_HOST=p.webshare.io
WEBSHARE_PROXY_PORT=80

# Apify token for Facebook scraping (sign up at apify.com for $5 free credit)
# Get token from https://console.apify.com/settings/integrations
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxx
